// wcf service
@using Microsoft.CodeAnalysis
@using Microsoft.CodeAnalysis.CSharp
@using Microsoft.CodeAnalysis.CSharp.Syntax
@using System.Collections.Generic;
@using System.Linq;
@using static Microsoft.CodeAnalysis.CSharp.SyntaxFactory

@namespace FuseCP.Build
@inherits RazorBlade.PlainTextTemplate

[System.CodeDom.Compiler.GeneratedCodeAttribute("FuseCP.Build", "1.0")]
#if NETFRAMEWORK
    [System.ServiceModel.Activation.AspNetCompatibilityRequirements(RequirementsMode = System.ServiceModel.Activation.AspNetCompatibilityRequirementsMode.Allowed)]
#endif
public class @(Class.Identifier): @(OldNamespace).@Class.Identifier, I@(Class.Identifier) {

	@if (WebServices.EmitOpenApiTypes || WebServices.EmitSwaggerWcfSecurity)
	{
		@foreach (MethodDeclarationSyntax method in WebMethods)
		{
			var argumentList = ArgumentList(
				SeparatedList<ArgumentSyntax>(method.ParameterList.Parameters
					.Select(par => new
					{
						Argument = Argument(IdentifierName(par.Identifier)),
						Parameter = par
					})
					.Select(par =>
					{
						var refKind = par.Parameter.Modifiers.FirstOrDefault(mod => mod.Text != "params");
						return refKind != default ? par.Argument.WithRefKindKeyword(refKind) : par.Argument;
					})));

			var callStatement = method.Modifiers.Any(mod => mod.IsKind(SyntaxKind.AsyncKeyword)) ?
				(method.ReturnType is GenericNameSyntax ? "return await " : "await ") :
				(method.ReturnType is PredefinedTypeSyntax pre && pre.Keyword.IsKind(SyntaxKind.VoidKeyword) ? "" : "return ");

			method.AttributeLists.Any(al => al.Attributes.Any(at => at.Name.ToString().EndsWith("SwaggerWcfReturnType")));
			method.AttributeLists.Any(al => al.Attributes.Any(at => at.Name.ToString().EndsWith("OpenApiResponse")));


			@if (WebServices.EmitOpenApiTypes && !hasSwaggerReturnTypeAttribute)
			{
				<text>
					#if NETFRAMEWORK
					[SwaggerWcfReturnType(typeof(@(method.ReturnType)))]
					#endif
				</text>
			}

			@if (WebServices.EmitOpenApiTypes && !hasOpenApiReturnTypeAttribute)
			{
				<text>
					#if !NETFRAMEWORK
					[OpenApiResponse(Type=typeof(@(method.ReturnType)), StatusCode = System.Net.HttpStatusCode.OK)]
					#endif
				</text>
			}

			@(method.AttributeLists)
			@if (IsAuthenticated && WebServices.EmitSwaggerWcfSecurity)
			{
				<text>
					#if NETFRAMEWORK
					[SwaggerWcfSecurity("basicAuth")]
					#endif
				</text>
			}

			<text>
			@(method.Modifiers) @(!method.Modifiers.Any(mod => mod.IsKeyword() && mod.Kind() == SyntaxKind.NewKeyword) ? "new " : "") @(method.ReturnType) @(method.Identifier)@(method.ParameterList) {
			@(callStatement)base.@(method.Identifier)@(argumentList)@(";")
				}
			</text>
		}
	}
}

@functions
{
	public string OldNamespace { get; set; }
	public ClassDeclarationSyntax Class { get; set; }
	public bool IsAuthenticated
	{
		get
		{
			return Class.AttributeLists
				.SelectMany(at => at.Attributes)
				.Any(at => at.Name.ToString() == "Policy" &&
					(at.ArgumentList.Arguments.Count != 1 || at.ArgumentList.Arguments[0].Expression.ToString() != "\"CommonPolicy\""));
		}
	}

	public IEnumerable<MethodDeclarationSyntax> WebMethods { get; set; }
}
