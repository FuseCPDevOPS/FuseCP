<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>disable</Nullable>
        <LangVersion>11</LangVersion>
        <DefineConstants>$(DefineConstants);Client</DefineConstants>
        <ImplicitUsings>disable</ImplicitUsings>
        <OutputPath>..\..\..\..\Bin</OutputPath>
        <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
        <SignAssembly>true</SignAssembly>
        <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)FuseCP.snk</AssemblyOriginatorKeyFile>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    </PropertyGroup>
    <ItemGroup>
        <Compile Remove="Microsoft.NET.Sdk.Razor.SourceGenerators\**" />
        <EmbeddedResource Remove="Microsoft.NET.Sdk.Razor.SourceGenerators\**" />
        <None Remove="Microsoft.NET.Sdk.Razor.SourceGenerators\**" />
        <Services Include="FuseCP.Build.WebServices\**\*.g.cs" />
        <Folder Include="FuseCP.Build.WebServices" />
    </ItemGroup>
    <PropertyGroup>
        <AnyServices>@(Services)</AnyServices>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="$(MSBuildThisFileDirectory)..\..\..\VersionInfo.cs" Link="VersionInfo.cs" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\..\FuseCP.EnterpriseServer.Base\FuseCP.EnterpriseServer.Base.csproj" />
        <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\..\FuseCP.Web.Clients\FuseCP.Web.Clients.csproj" />
        <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\..\FuseCP.EnterpriseServer\FuseCP.EnterpriseServer.csproj"
            ReferenceOutputAssembly="false" PrivateAssets="All" Condition="'$(AnyServices)' == ''" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="System.ServiceModel.Primitives" Version="10.0.652802" />
        <PackageReference Include="System.DirectoryServices" Version="10.0.0" />
    </ItemGroup>

    <Target Name="RerunAnalyzer" Condition="'$(AnyServices)' == ''" BeforeTargets="ResolveProjectReferences">
        <Touch Files="$(MSBuildThisFileDirectory)..\..\Properties\AssemblyInfo.cs" />
        <Message Text="RerunAnalyzer" Importance="high" />
    </Target>
    
    <Target Name="ReevaluateCompile" Condition="'$(AnyServices)' == ''" AfterTargets="ResolveProjectReferences">
        <ItemGroup>
            <Compile Remove="**/*.cs" />
            <Compile Include="**/*.cs" Exclude="obj/**/*.cs" />
        </ItemGroup>
        <Message Text="ReevaluateCompile: @(Compile)" Importance="high" />
    </Target>

    <Target Name="NormalizeGeneratedServiceBaseNames" BeforeTargets="CoreCompile" Condition="Exists('$(MSBuildThisFileDirectory)FuseCP.Build.WebServices')">
        <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)Normalize-GeneratedWebServices.ps1&quot; -RootPath &quot;$(MSBuildThisFileDirectory)FuseCP.Build.WebServices&quot;" />
    </Target>

</Project>

