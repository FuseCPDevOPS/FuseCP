<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<OutputPath>..\FuseCP.Server\bin\Sharepoint2019\</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<LangVersion>11</LangVersion>
		<Nullable>disable</Nullable>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
		<DebugType>full</DebugType>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
		<DebugType>pdbonly</DebugType>
	</PropertyGroup>
	<ItemGroup>
		<Compile Include="..\VersionInfo.cs" Link="VersionInfo.cs" />
	</ItemGroup>
	<ItemGroup>
		<Reference Include="Microsoft.SharePoint">
			<HintPath>..\..\Lib\References\Microsoft\Microsoft.SharePoint.dll</HintPath>
			<Private>False</Private>
		</Reference>
<ProjectReference Include="..\FuseCP.Providers.Base\FuseCP.Providers.Base.csproj" />
		<ProjectReference Include="..\FuseCP.Providers.HostedSolution\FuseCP.Providers.HostedSolution.csproj" />
		<ProjectReference Include="..\FuseCP.Server.Utils\FuseCP.Server.Utils.csproj" />
	</ItemGroup>

    <Target Name="DeleteUnusedDlls" AfterTargets="Build">
        <ItemGroup>
            <FilesToDelete Include="$(OutputPath)System.*" />
            <FilesToDelete Include="$(OutputPath)Renci.*" />
            <FilesToDelete Include="$(OutputPath)Newtonsoft.*" />
            <FilesToDelete Include="$(OutputPath)Standard.*" />
            <FilesToDelete Include="$(OutputPath)BouncyCastle.*" />
            <FilesToDelete Include="$(OutputPath)Microsoft.Bcl.*" />
            <FilesToDelete Include="$(OutputPath)Microsoft.Extensions.*" />
            <FilesToDelete Include="$(OutputPath)Mono.*" />
            <FilesToDelete Include="$(OutputPath)FuseCP.Providers.Base.*" />
            <FilesToDelete Include="$(OutputPath)FuseCP.Server.Utils.*" />
            <FilesToDelete Include="$(OutputPath)FuseCP.Providers.HostedSolution.*" />
            <FilesToDelete Include="$(OutputPath)Microsoft.Win32.*" />
        </ItemGroup>
        <Delete Files="@(FilesToDelete)" />
    </Target>

    <ItemGroup>
        <PackageReference Include="System.Management.Automation" Version="7.6.2" />
    </ItemGroup>
</Project>
