<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	<RootNamespace>FuseCP.Providers.OS</RootNamespace>
    <TargetFramework>net10.0-windows</TargetFramework>
    <WarningsAsErrors>618</WarningsAsErrors>
    <OutputPath>..\FuseCP.Server\bin\Providers\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    
    <LangVersion>11</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugType>full</DebugType>
  </PropertyGroup>
  <ItemGroup>
	<Reference Include="Microsoft.Web.Management, Version=7.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35, processorArchitecture=MSIL">
	 <HintPath>..\..\Lib\References\Microsoft\Microsoft.Web.Management.dll</HintPath>
	 <SpecificVersion>False</SpecificVersion>
	</Reference>
	<Reference Include="Microsoft.Web.PlatformInstaller, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35, processorArchitecture=MSIL">
	 <HintPath>..\..\Lib\References\Microsoft\Microsoft.Web.PlatformInstaller.dll</HintPath>
	 <Private>True</Private>
	 <SpecificVersion>False</SpecificVersion>
	</Reference>
    <Reference Include="System.Management" />
</ItemGroup>
  <ItemGroup>
    <Compile Include="..\VersionInfo.cs" Link="VersionInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.8" />
    <PackageReference Include="System.Management.Automation" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FuseCP.Providers.Base\FuseCP.Providers.Base.csproj" />
    <ProjectReference Include="..\FuseCP.Server.Utils\FuseCP.Server.Utils.csproj" />
  </ItemGroup>

  <Target Name="CopyServiceProcessRuntimeToProviders" AfterTargets="Build">
    <ItemGroup>
      <ServiceControllerRuntimeDll Include="$(NuGetPackageRoot)system.serviceprocess.servicecontroller\10.0.8\runtimes\win\lib\net10.0\System.ServiceProcess.ServiceController.dll" Condition="Exists('$(NuGetPackageRoot)system.serviceprocess.servicecontroller\10.0.8\runtimes\win\lib\net10.0\System.ServiceProcess.ServiceController.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(ServiceControllerRuntimeDll)" DestinationFolder="$(OutputPath)" Condition="'@(ServiceControllerRuntimeDll)' != ''" />
    <Copy SourceFiles="@(ServiceControllerRuntimeDll)" DestinationFolder="$(OutputPath)runtimes\win\lib\net10.0" Condition="'@(ServiceControllerRuntimeDll)' != ''" />
  </Target>
</Project>



