@using FuseCP.WebDavPortal.Resources
@using FuseCP.WebDavPortal.UI
<div class="modal fade" id="confirm-dialog" tabindex="-1" role="dialog" aria-labelledby="confirm-dalog-label">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                <h4 class="modal-title" id="confirm-dalog-label">@UI.Confirm</h4>
            </div>

            <div class="modal-body">

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@UI.Cancel</button>
                <a href="#" class="btn btn-danger danger  positive-button" data-bs-dismiss="modal">@UI.Yes</a>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="confirm-dialog-2" tabindex="-1" role="dialog" aria-labelledby="confirm-dalog-label">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                <h4 class="modal-title" id="confirm-dalog-label">@UI.Confirm</h4>
            </div>

            <div class="modal-body">

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" onclick="fcp.fileBrowser.refreshDeletionBlock();fcp.fileBrowser.refreshDataTable(fcp.fileBrowser.itemsTable);">@UI.Cancel</button>
                <a href="#" class="btn btn-danger danger  positive-button" data-bs-dismiss="modal">@UI.Yes</a>
            </div>
        </div>
    </div>
</div>
