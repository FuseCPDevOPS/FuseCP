<?xml version="1.0"?>
<!-- Legacy MVC5 Views/Web.config superseded by Views/_ViewImports.cshtml for ASP.NET Core. -->
<!-- Retain for net48 build compatibility only. -->
<configuration>
	<system.webServer>
		<httpProtocol>
			<customHeaders>
				<add name="X-Frame-Options" value="SAMEORIGIN" />
				<add name="X-Content-Type-Options" value="nosniff" />
			</customHeaders>
		</httpProtocol>
	</system.webServer>
</configuration>
