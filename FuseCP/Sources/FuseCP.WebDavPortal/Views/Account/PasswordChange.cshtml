@using FuseCP.WebDavPortal.Resources
@using FuseCP.WebDavPortal.UI.Routes
@model FuseCP.WebDavPortal.Models.Account.PasswordChangeModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container row">
    @using (Html.BeginRouteForm(AccountRouteNames.PasswordChange, FormMethod.Post, new { @class = "user-password-change bs-val-styles col-lg-10 ms-lg-3", id = "user-password-change" }))
    {
        <div class="mb-3">
            <h3>@UI.ChangePassword</h3>
        </div>
        <div class="row mb-3">
            <label for="@Html.IdFor(x => x.OldPassword)" class="col-sm-2 col-form-label">@UI.OldPassword</label>
            <div class="col-sm-10">
                @Html.PasswordFor(x => x.OldPassword, new { @class = "form-control", placeholder = UI.OldPassword })
                @Html.ValidationMessageFor(x => x.OldPassword)
            </div>
        </div>

        @Html.EditorFor(x=>x.PasswordEditor)

        <div class="row mb-3">
            <div class="col-sm-10 ms-sm-2">
                <button type="submit" class="btn btn-secondary">@UI.ChangePassword</button>
            </div>
        </div>
    }
</div>
