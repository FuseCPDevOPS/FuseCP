@using FuseCP.WebDavPortal.Resources
@using FuseCP.WebDavPortal.UI.Routes
@model FuseCP.WebDavPortal.Models.AccountModel
@{
    ViewBag.Title = "Login";
    //Layout = "~/Views/Shared/_Layout.cshtml";
}

<br/>
<div class="container">
    <form method="POST" role="form">
        @Html.HiddenFor(x=>x.PasswordResetEnabled)
        <div class="mb-3">
            <h3 class="ms-sm-1">Sign In</h3>
        </div>
        @if (Model != null && !string.IsNullOrEmpty(Model.LdapError))
        {
            <div class="mb-3">
                <span class="ms-sm-1" style="color: #A94442; font-weight: bold;">@Model.LdapError</span>
            </div>
        }
        <div class="row mb-3">
            <label for="inputLogin" class="col-sm-2 col-form-label">Login</label>
            <div class="col-sm-10">
                @Html.TextBoxFor(x => x.Login, new { @class = "form-control", id = "inputLogin", placeholder = "Login", autofocus = "autofocus" })
            </div>
        </div>
        <div class="row mb-3">
            <label for="inputPassword" class="col-sm-2 col-form-label">Password</label>
            <div class="col-sm-10">
                @Html.PasswordFor(x => x.Password, new { @class = "form-control", id = "inputPassword", placeholder = "Password" })
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-sm-10 ms-sm-2">
                <button type="submit" class="btn btn-secondary">Sign in</button>
                @if (Model.PasswordResetEnabled)
                {
                    <a href="@Url.RouteUrl(AccountRouteNames.PasswordResetLogin)" class="forgot-your-password-link">@UI.ForgotYourPassword</a>
                }
            </div>
        </div>
    </form>
</div>


@section scripts
{
    <script>
        $(document).ready(function () {
            $('[autofocus]').focus();
        });
    </script>
}
